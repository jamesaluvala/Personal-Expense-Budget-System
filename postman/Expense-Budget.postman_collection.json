{
  "info": {
    "name": "Personal Expense & Budget - Real API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against a disposable hosted/test database. Creates a unique test account and clearly marked real test entries, then deletes those entries. The test account/category labels remain. All mutating requests automatically fetch a CSRF token; enable cookies. Never use with a personal financial account."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base = pm.environment.get('baseUrl');",
          "if (!base || base.includes('replace-me')) throw new Error('Set baseUrl to your actual HTTPS app URL (without /api).');",
          "if (['POST','PUT','DELETE'].includes(pm.request.method)) {",
          "  pm.sendRequest({url: base.replace(/\\/$/, '') + '/api/auth/csrf', method:'GET'}, (err,res) => {",
          "    if (err || res.code !== 200) throw new Error('Cannot obtain CSRF token; check baseUrl, cookies and backend health.');",
          "    const csrf = res.json();",
          "    pm.request.headers.upsert({key:csrf.headerName, value:csrf.token});",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Database healthy', () => pm.expect(pm.response.json().status).to.eql('UP'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Current date and currency",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/meta"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const m=pm.response.json();",
              "pm.collectionVariables.set('today',m.today); pm.collectionVariables.set('month',m.today.slice(0,7));",
              "const d=new Date(m.today+'T12:00:00Z'); d.setUTCMonth(d.getUTCMonth()+6);",
              "pm.collectionVariables.set('targetDate',d.toISOString().slice(0,10));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Register unique TEST account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Test User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id=pm.variables.replaceIn('{{$guid}}'); pm.collectionVariables.set('testEmail','postman-'+id+'@example.com'); pm.collectionVariables.set('testPassword','Test-only-'+id+'!');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Login (form body)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "email",
              "value": "{{testEmail}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{testPassword}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Private profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('No password returned', () => pm.expect(pm.response.json()).not.to.have.property('passwordHash'));"
            ]
          }
        }
      ]
    },
    {
