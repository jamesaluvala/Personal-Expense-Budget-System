      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const c=pm.response.json();",
              "pm.collectionVariables.set('incomeCategory',c.find(x=>x.type==='INCOME').id);",
              "pm.collectionVariables.set('expenseCategory',c.find(x=>x.type==='EXPENSE').id);",
              "pm.test('Ten labels only',()=>pm.expect(c.length).to.eql(10));"
            ]
          }
        }
      ]
    },
    {
